{
  "expo": {
    "scheme": "issuewatch",
    "name": "IssueWatch",
    "slug": "IssueWatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biki.IssueWatch"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#6366F1"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/logo.png",
      "color": "#6366F1",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new issues"
    },
    "extra": {
      "apiUrl": "https://opensource-issue-notify.onrender.com/api",
      "eas": {
        "projectId": "b7237777-4b8d-46ed-aed0-f3a3f4ca8827"
      }
    },
    "android": {
      "package": "com.biki.IssueWatch",
      "googleServicesFile": "./google-services.json"
    },
    "owner": "trialssd"
  }
}
